{
	"name": "@dont-forget/tooling",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"biome:check": "biome ci .",
		"format": "biome check --write .",
		"lint": "eslint .",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"test:eslint-rules": "node eslint-plugin/package-boundaries.test.js && node eslint-plugin/no-raw-color-literals.test.js",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"eslint": "^9.25.0",
		"expo": "~56.0.12",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@types/jest": "29.5.14",
		"@types/node": "26.1.1",
		"babel-jest": "29.7.0",
		"jest": "~29.7.0",
		"typescript": "~6.0.3"
	}
}
