# Throwaway local-only credentials for the spike. NOT a secret — local Docker only.
# Source (replicated) Postgres — holds all Household data.
PG_DATABASE_NAME=postgres
PG_DATABASE_PORT=5499
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=spike_local_only
PS_DATA_SOURCE_URI=postgres://postgres:spike_local_only@pg-source:5499/postgres

# Bucket-storage Postgres — separate DB, internal to PowerSync.
PG_STORAGE_DATABASE_NAME=postgres
PG_STORAGE_DATABASE_PORT=5498
PG_STORAGE_DATABASE_USER=postgres
PG_STORAGE_DATABASE_PASSWORD=spike_local_only
PS_STORAGE_SOURCE_URI=postgres://postgres:spike_local_only@pg-storage:5498/postgres

# PowerSync API port (host == container).
PS_PORT=8089

# Node upload endpoint port.
DEMO_BACKEND_PORT=6068
