{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{js,cjs,mjs,ts,tsx,json,jsonc}",
			"!!**/dist",
			"!!.agents",
			"!!.claude",
			"!!.omx",
			"!!apps/web/src/routeTree.gen.ts",
			"!!packages/db/src/migrations/**/meta/*.json",
			"!!apps/mobile/.rnstorybook/storybook.requires.ts",
			"!!skills-lock.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
