{
	"name": "@dont-forget/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./fixtures": "./src/fixtures/index.ts",
		"./migrations/*": "./src/migrations/*",
		"./schema": "./src/schema/postgres/index.ts",
		"./test": "./src/test.ts"
	},
	"scripts": {
		"biome:check": "biome ci .",
		"db:generate": "tsx src/generate.ts",
		"db:migrate": "tsx src/migrate.ts",
		"db:reset": "tsx src/reset.ts",
		"db:reseed": "tsx scripts/reseed.ts",
		"db:seed": "tsx scripts/seed.ts",
		"format": "biome check --write .",
		"lint": "eslint .",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"worktree:db": "tsx scripts/worktree-db.ts",
		"worktree:db:destroy": "tsx scripts/worktree-db-destroy.ts"
	},
	"dependencies": {
		"@dont-forget/shared": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@electric-sql/pglite": "^0.5.3",
		"@types/jest": "29.5.14",
		"@types/node": "26.1.1",
		"@types/pg": "^8.20.0",
		"babel-jest": "29.7.0",
		"drizzle-kit": "^0.31.10",
		"jest": "~29.7.0",
		"tsx": "^4.21.0",
		"typescript": "~6.0.3"
	}
}
