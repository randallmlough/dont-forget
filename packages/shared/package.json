{
	"name": "@dont-forget/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./node": "./src/node.ts"
	},
	"scripts": {
		"biome:check": "biome ci .",
		"format": "biome check --write .",
		"lint": "eslint .",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@types/jest": "29.5.14",
		"@types/node": "26.1.1",
		"babel-jest": "29.7.0",
		"jest": "~29.7.0",
		"typescript": "~6.0.3"
	}
}
