# --- Turso ---------------------------------------------------------
# Organization slug (https://turso.tech/app)
TURSO_ORG=

# Directory DB (server-only — holds households, memberships, invitations)
TURSO_DIRECTORY_URL=libsql://dont-forget-directory-<org>.turso.io
TURSO_DIRECTORY_AUTH_TOKEN=

# Platform API token — used to provision per-Household DBs and mint
# scoped Member tokens. NEVER ship this in the app.
TURSO_PLATFORM_API_TOKEN=

# Group-scoped auth token used when running migrations against any
# per-Household DB. Must have write access to the group those DBs live in.
TURSO_PLATFORM_GROUP_TOKEN=

# --- Clerk ---------------------------------------------------------
# Publishable key — safe to ship in the app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key — server-only, used by API Routes to verify sessions
CLERK_SECRET_KEY=

# --- Resend --------------------------------------------------------
# Server-only, used by API Routes to send invitation emails
RESEND_API_KEY=
RESEND_FROM_ADDRESS=invites@yourdomain.com
