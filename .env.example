# Copy to .env.local for local app development. Staging and production
# secrets should live in EAS/GitHub/operator secret stores, not in git.

# --- Environment ---------------------------------------------------
# One of: local, test, staging, production
APP_ENV=local

# Public API base URL. Required for local, staging, and production app builds.
EXPO_PUBLIC_API_BASE_URL=

# Optional app identity overrides. app.config.ts derives environment-specific
# local/staging identifiers when these are omitted.
EXPO_APP_NAME=
EXPO_SCHEME=
IOS_BUNDLE_IDENTIFIER=

# --- Development ---------------------------------------------------
EXPO_WITH_ROCKETSIM_CONNECT=

# --- Turso ---------------------------------------------------------
# Organization slug (https://turso.tech/app). Persistent environments use
# groups named dont-forget-<env>; local uses a per-developer group.
TURSO_ORG=
TURSO_GROUP=dont-forget-local-<name>

# Directory DB (server-only — holds households, memberships, invitations)
TURSO_DIRECTORY_URL=libsql://dont-forget-local-<name>-directory-<org>.turso.io
TURSO_DIRECTORY_AUTH_TOKEN=

# Platform API token — used to provision per-Household DBs and mint
# scoped Member tokens. NEVER ship this in the app.
TURSO_PLATFORM_API_TOKEN=

# Group-scoped auth token used when running migrations against any
# per-Household DB. Must have write access to the group those DBs live in.
TURSO_PLATFORM_GROUP_TOKEN=

# --- Clerk ---------------------------------------------------------
# Publishable key — safe to ship in the app. Non-production uses pk_test_*. Production uses pk_live_*.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# Secret key — server-only, used by API Routes to verify sessions
CLERK_SECRET_KEY=sk_test_

# --- Resend --------------------------------------------------------
# Server-only, used by API Routes to send invitation emails
RESEND_API_KEY=
RESEND_FROM_ADDRESS=invites@yourdomain.com

# --- PostHog -------------------------------------------------------
# Public project token and host. Events/logs are tagged with APP_ENV.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
