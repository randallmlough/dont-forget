# Copy to .env.local for local app development. Staging and production
# secrets should live in EAS/GitHub/operator secret stores, not in git.

# --- Global --------------------------------------------------------
# One of: local, test, staging, production
APP_ENV=local

# --- MOBILE APP --------------------------------------------------------
# Public API base URL. Required for staging and production app builds; local
# development derives its API origin from Metro.
EXPO_PUBLIC_API_BASE_URL= # http://localhost:8081

# Public legal URLs shown in app settings.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# Optional app display-name override. Scheme, bundle identifier, and Apple app
# ID derive only from APP_ENV.
EXPO_APP_NAME=

EXPO_WITH_ROCKETSIM_CONNECT=

# Publishable key — safe to ship in the app. Non-production uses pk_test_*. Production uses pk_live_*.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# PowerSync client connector endpoint.
EXPO_PUBLIC_POWERSYNC_URL=

# --- Shared --------------------------------------------------------
# Public project token and host. Events/logs are tagged with APP_ENV.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# --- Server --------------------------------------------------------
# Standalone API listener port. 8080 is the non-worktree default; in linked
# worktrees, `make worktree-env` writes a checkout-local override to
# `.env.worktree`.
API_PORT=8080

# Dedicated public web listener port. 3000 is the non-worktree default; in
# linked worktrees, `make worktree-env` writes a checkout-local override to
# `.env.worktree`.
WEB_PORT=3000

# Root public origin used to build Invitation and Household Join Code links.
# It must differ from the API and PowerSync origins. Set it in the selected EAS
# preview/production environment as well as the matching API operator env.
# In linked worktrees, `make worktree-env` generates the matching local
# `http://localhost:<WEB_PORT>` value in `.env.worktree` for Simulator/browser
# use; an iPhone needs a separately reachable HTTPS origin for public-link QA.
PUBLIC_WEB_BASE_URL= # http://localhost:3000

# Clerk secret key used by API Routes to verify sessions.
CLERK_SECRET_KEY=sk_test_

# Resend configuration used by API Routes to send invitation emails.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=invites@yourdomain.com

# Source Postgres (server + drizzle migrate). NEVER commit the real value.
DATABASE_URL=

# Compose-only vars for the local, staging, and production files selected by
# `make infra-* APP_ENV=<environment>`.
PG_DATABASE_USER=
PG_DATABASE_NAME=
PG_DATABASE_PASSWORD=
PG_STORAGE_DATABASE_USER=
PG_STORAGE_DATABASE_NAME=
PG_STORAGE_DATABASE_PASSWORD=
PS_DATA_SOURCE_URI=
PS_STORAGE_SOURCE_URI=
PS_PORT=
# Clerk frontend-API JWKS URL for the env's Clerk instance (PowerSync token verification).
# Dev e.g. https://<your-dev-subdomain>.clerk.accounts.dev/.well-known/jwks.json
PS_CLERK_JWKS_URI=
