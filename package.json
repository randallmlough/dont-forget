{
	"name": "dont-forget",
	"main": "index.ts",
	"version": "1.0.0",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost",
		"ios": "expo run:ios",
		"storybook:start": "STORYBOOK_ENABLED=true expo start --dev-client",
		"storybook:ios": "STORYBOOK_ENABLED=true expo run:ios",
		"storybook:generate": "sb-rn-get-stories",
		"biome:check": "biome ci .",
		"format": "biome check --write .",
		"lint": "eslint .",
		"test": "jest --watch",
		"test:ci": "jest --runInBand",
		"test:eslint-rules": "node tools/eslint-rules/no-screen-use-effect.test.js && node tools/eslint-rules/no-server-service-imports.test.js && node tools/eslint-rules/no-db-imports-outside-services.test.js",
		"test:coverage": "jest --coverage --runInBand",
		"typecheck": "tsc --noEmit",
		"db:generate": "tsx db/generate.ts",
		"db:migrate": "tsx db/migrate.ts",
		"db:reset": "tsx db/reset.ts",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@babel/core": "^7.29.0",
		"@clerk/backend": "^3.4.7",
		"@clerk/clerk-expo": "^2.19.36",
		"@expo/ui": "~55.0.16",
		"@expo/vector-icons": "^15.0.3",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@libsql/client": "^0.17.3",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-native-community/datetimepicker": "^8.6.0",
		"@react-native-community/netinfo": "^12.0.1",
		"@react-native-community/slider": "^5.1.2",
		"@react-native/normalize-colors": "0.83.6",
		"@react-navigation/bottom-tabs": "^7.4.0",
		"@react-navigation/elements": "^2.6.3",
		"@react-navigation/native": "^7.1.8",
		"@storybook/addon-ondevice-actions": "^10.4.1",
		"@storybook/addon-ondevice-controls": "^10.4.1",
		"@storybook/react-native": "^10.4.1",
		"@tursodatabase/sync-react-native": "^0.6.0",
		"babel-loader": "^8.4.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"expo": "~55.0.24",
		"expo-apple-authentication": "~55.0.13",
		"expo-auth-session": "~55.0.16",
		"expo-constants": "~55.0.16",
