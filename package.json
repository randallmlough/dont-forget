		"@types/react": "~19.2.14",
		"@typescript-eslint/eslint-plugin": "8.59.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.25.0",
		"eslint-config-expo": "~55.0.1",
		"eslint-plugin-react-native-a11y": "^3.5.1",
		"jest": "~29.7.0",
		"jest-expo": "~55.0.17",
