{
  "name": "dont-forget",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "db:generate:directory": "drizzle-kit generate --config=drizzle.directory.config.ts",
    "db:generate:household": "drizzle-kit generate --config=drizzle.household.config.ts",
    "db:generate": "npm run db:generate:directory && npm run db:generate:household",
    "db:migrate": "tsx db/migrate.ts"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/vector-icons": "^15.0.3",
