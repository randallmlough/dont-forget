		"@testing-library/react-native": "^14.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/jest": "29.5.14",
		"@types/pg": "^8.20.0",
		"@types/react": "~19.2.14",
		"@typescript-eslint/eslint-plugin": "8.59.1",
		"better-sqlite3": "^12.11.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.25.0",
		"eslint-config-expo": "~56.0.4",
		"eslint-plugin-react-native-a11y": "^3.5.1",
		"jest": "~29.7.0",
		"jest-expo": "~56.0.5",
		"test-renderer": "^1.2.0",
		"tsx": "^4.21.0",
		"typescript": "~6.0.3"
