{
	"name": "dont-forget",
	"main": "index.ts",
	"version": "1.0.0",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost",
		"ios": "expo run:ios",
		"storybook:start": "STORYBOOK_ENABLED=true expo start --dev-client",
		"storybook:ios": "STORYBOOK_ENABLED=true expo run:ios",
		"storybook:generate": "sb-rn-get-stories",
		"biome:check": "biome ci .",
		"format": "biome check --write .",
		"lint": "eslint .",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:eslint-rules": "node tooling/eslint-plugin/no-screen-use-effect.test.js && node tooling/eslint-plugin/no-server-service-imports.test.js && node tooling/eslint-plugin/no-db-imports-outside-services.test.js && node tooling/eslint-plugin/no-db-server-imports.test.js && node tooling/eslint-plugin/no-services-imports-in-db.test.js && node tooling/eslint-plugin/no-lib-api-imports.test.js && node tooling/eslint-plugin/no-raw-color-literals.test.js",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"typecheck": "tsc --noEmit",
		"db:generate": "tsx db/server/generate.ts",
		"db:migrate": "tsx db/server/migrate.ts",
		"db:reset": "tsx db/server/reset.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:reseed": "tsx scripts/reseed.ts",
		"worktree:db": "tsx tooling/scripts/worktree-db.ts",
		"worktree:db:destroy": "tsx tooling/scripts/worktree-db-destroy.ts",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@azure/core-asynciterator-polyfill": "^1.0.2",
		"@babel/core": "^7.29.0",
		"@clerk/backend": "^3.4.7",
		"@clerk/clerk-expo": "^2.19.36",
		"@expo/ui": "~56.0.18",
		"@op-engineering/op-sqlite": "^16.2.0",
		"@powersync/op-sqlite": "^0.9.10",
		"@powersync/react": "^1.10.0",
		"@powersync/react-native": "^1.35.4",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-native-community/datetimepicker": "^9.1.0",
		"@react-native-community/netinfo": "^12.0.1",
		"@react-native-community/slider": "^5.2.0",
		"@react-native/normalize-colors": "0.85.3",
		"@storybook/addon-ondevice-actions": "^10.4.1",
