	"private": true,
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3"
		],
		"overrides": {
			"js-cookie": "3.0.7",
			"shell-quote": ">=1.8.4",
			"esbuild@<0.28.1": ">=0.28.1",
			"form-data@>=4.0.0 <4.0.6": ">=4.0.6",
			"ws@>=7.0.0 <7.5.11": ">=7.5.11",
			"ws@>=8.0.0 <8.20.1": ">=8.20.1",
			"brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
			"uuid@<11.1.1": ">=11.1.1"
		}
	}
