{
	"name": "@dont-forget/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"biome:check": "biome ci .",
		"build": "tsx scripts/build-api.ts",
		"dev": "tsx watch src/main.ts",
		"format": "biome check --write .",
		"lint": "eslint .",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@clerk/backend": "^3.4.7",
		"@dont-forget/db": "workspace:*",
		"@dont-forget/shared": "workspace:*",
		"@hono/node-server": "^2.0.11",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.31",
		"pg": "^8.22.0",
		"posthog-node": "^5.35.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@types/jest": "29.5.14",
		"@types/node": "26.1.1",
		"@types/pg": "^8.20.0",
		"babel-jest": "29.7.0",
		"esbuild": "0.28.1",
		"jest": "~29.7.0",
		"tsx": "^4.21.0",
		"typescript": "~6.0.3"
	}
}
