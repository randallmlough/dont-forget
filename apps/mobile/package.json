{
	"name": "@dont-forget/mobile",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"main": "index.ts",
	"scripts": {
		"biome:check": "biome ci .",
		"dev": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost",
		"expo:check": "expo install --check",
		"expo:config": "expo config --type public",
		"format": "biome check --write .",
		"ios": "expo run:ios",
		"lint": "eslint .",
		"storybook:generate": "sb-rn-get-stories",
		"storybook:start": "STORYBOOK_ENABLED=true expo start --dev-client",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
