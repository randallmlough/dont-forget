{
	"name": "@dont-forget/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"biome:check": "biome ci .",
		"build": "vite build && node --experimental-strip-types scripts/verify-static-artifact.mjs",
		"dev": "vite dev",
		"format": "biome check --write .",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"verify:static": "node --experimental-strip-types scripts/verify-static-artifact.mjs"
	},
	"dependencies": {
		"@dont-forget/shared": "workspace:*",
		"@tanstack/react-router": "1.170.18",
		"@tanstack/react-start": "1.168.32",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@types/jest": "29.5.14",
		"@types/node": "26.1.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"babel-jest": "29.7.0",
		"jest": "~29.7.0",
		"typescript": "6.0.3",
		"vite": "8.0.16"
	}
}
